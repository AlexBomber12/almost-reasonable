FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/almost-reasonable

COPY app/core/agent_proposals.py app/core/context.py app/core/core_self.py app/core/events.py app/core/model_contract.py app/core/openai_worker_client.py app/core/provider_contract.py app/core/provider_spend.py app/core/store.py /opt/almost-reasonable/app/core/
COPY app/trusted/openai_gateway.py app/trusted/openai_transport.py app/trusted/openai_worker_protocol.py app/trusted/openai_worker_server.py /opt/almost-reasonable/app/trusted/
COPY app/ops/openai_worker_probe.py /opt/almost-reasonable/app/ops/

USER 11001:11001

CMD ["python", "-B", "-m", "app.trusted.openai_worker_server", "--socket", "/run/almost-reasonable/openai-worker.sock", "--database", "/var/lib/almost-reasonable/provider.sqlite3", "--allow-uid", "11002", "--socket-group-gid", "11000"]
